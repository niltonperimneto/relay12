+
+static void d3d11_on12_free_shader_resource_view(void *object)
+{
+    struct d3d_shader_resource_view *view = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(view->device);
+    device->backend_ops->destroy_srv(device, view);
+    wined3d_private_store_cleanup(&view->private_store);
+    d3d11_backend_child_decref(&unsafe_impl_from_ID3D11Texture2D((ID3D11Texture2D *)view->resource)->backend_child);
+    free(view);
+}
+
+static HRESULT d3d11_on12_backend_create_srv(struct d3d_device *device, ID3D11Resource *resource,
+        const D3D11_SHADER_RESOURCE_VIEW_DESC *desc, struct d3d_shader_resource_view *view)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    struct d3d_texture2d *texture = d3d11_on12_texture(resource);
+    HRESULT hr;
+    if (!texture || texture->device != &device->ID3D11Device5_iface) return E_INVALIDARG;
+    view->backend_view.size = sizeof(view->backend_view);
+    hr = backend->create_srv(&backend->adapter, &texture->backend_texture, desc, &view->backend_view);
+    if (SUCCEEDED(hr))
+    {
+        view->backend_child.refs = 1;
+        view->backend_child.object = view;
+        view->backend_child.destroy = d3d11_on12_free_shader_resource_view;
+        d3d11_backend_child_incref(&texture->backend_child);
+    }
+    return hr;
+}
+
+static void d3d11_on12_backend_destroy_srv(struct d3d_device *device, struct d3d_shader_resource_view *view)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    HRESULT hr = backend->destroy_srv(&view->backend_view);
+    if (FAILED(hr)) WARN("On12 SRV destruction failed, hr %#lx.\n", hr);
+}
+
+static void d3d11_on12_backend_set_pixel_resources(struct d3d11_device_context *context,
+        UINT start, UINT count, ID3D11ShaderResourceView *const *views)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_rendertarget_view *rtv = context->bound_rtv ? context->bound_rtv->object : NULL;
+    struct d3d_shader_resource_view *resolved[D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT];
+    void *handles[D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT];
+    UINT i;
+    HRESULT hr;
+    if (start > ARRAY_SIZE(handles) || count > ARRAY_SIZE(handles) - start || (count && !views)) return;
+    for (i = 0; i < count; ++i)
+    {
+        struct d3d_shader_resource_view *view = unsafe_impl_from_ID3D11ShaderResourceView(views[i]);
+        if (view && (view->device != &context->device->ID3D11Device5_iface || !view->backend_child.destroy))
+        { WARN("On12 SRV binding requires views from this device.\n"); return; }
+        if (view && rtv && rtv->resource == view->resource) view = NULL;
+        resolved[i] = view;
+        handles[i] = view ? &view->backend_view : NULL;
+    }
+    hr = backend->set_pixel_resources(&backend->adapter, start, count, handles);
+    if (FAILED(hr)) { WARN("On12 SRV binding failed, hr %#lx.\n", hr); return; }
+    for (i = 0; i < count; ++i)
+        d3d11_backend_child_bind(&context->bound_ps_srvs[start + i], resolved[i] ? &resolved[i]->backend_child : NULL);
+}
