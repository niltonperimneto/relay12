 /* ID3D11RenderTargetView, ID3D10RenderTargetView */
 struct d3d_rendertarget_view
 {
+    struct { UINT size, reserved; void *driver_view, *runtime_state; } backend_view;
     ID3D11RenderTargetView ID3D11RenderTargetView_iface;
     ID3D10RenderTargetView ID3D10RenderTargetView_iface;
     LONG refcount;
@@ -604,6 +605,10 @@ struct d3d11_device_context
  * immediate context. WineD3D remains the default backend. */
 struct d3d11_backend_ops
 {
+    HRESULT (*create_rtv)(struct d3d_device *, ID3D11Resource *,
+            const D3D11_RENDER_TARGET_VIEW_DESC *, struct d3d_rendertarget_view *);
+    void (*destroy_rtv)(struct d3d_device *, struct d3d_rendertarget_view *);
+
     void (*destroy_device)(struct d3d_device *device);
     D3D_FEATURE_LEVEL (*get_feature_level)(struct d3d_device *device);
     UINT (*get_creation_flags)(struct d3d_device *device);
diff --git a/dlls/d3d11/view.c b/dlls/d3d11/view.c
index ec55dba5..ca8c88f9 100644
--- a/dlls/d3d11/view.c
+++ b/dlls/d3d11/view.c
@@ -1397,7 +1397,7 @@ static ULONG STDMETHODCALLTYPE d3d11_rendertarget_view_AddRef(ID3D11RenderTarget
 
     TRACE("%p increasing refcount to %lu.\n", view, refcount);
 
-    if (refcount == 1)
+    if (refcount == 1 && !view->backend_view.runtime_state)
     {
         ID3D11Device5_AddRef(view->device);
         wined3d_rendertarget_view_incref(view->wined3d_view);
@@ -1416,6 +1416,16 @@ static ULONG STDMETHODCALLTYPE d3d11_rendertarget_view_Release(ID3D11RenderTarge
     if (!refcount)
     {
         ID3D11Device5 *device = view->device;
+        if (view->backend_view.runtime_state)
+        {
+            struct d3d_device *owner = impl_from_ID3D11Device5(device);
+            owner->backend_ops->destroy_rtv(owner, view);
+            ID3D11Resource_Release(view->resource);
+            wined3d_private_store_cleanup(&view->private_store);
+            free(view);
+            ID3D11Device5_Release(device);
+            return 0;
+        }
         wined3d_rendertarget_view_decref(view->wined3d_view);
         ID3D11Device5_Release(device);
     }
@@ -1727,6 +1737,16 @@ static HRESULT d3d_rendertarget_view_init(struct d3d_rendertarget_view *view, st
     if (FAILED(hr))
         return hr;
 
+    if (device->backend_ops->create_rtv)
+    {
+        if (FAILED(hr = device->backend_ops->create_rtv(device, resource, &view->desc, view))) return hr;
+        wined3d_private_store_init(&view->private_store);
+        view->resource = resource;
+        ID3D11Resource_AddRef(resource);
+        ID3D11Device5_AddRef(view->device = &device->ID3D11Device5_iface);
+        return S_OK;
+    }
+
     wined3d_mutex_lock();
     if (!(wined3d_resource = wined3d_resource_from_d3d11_resource(resource)))
     {
