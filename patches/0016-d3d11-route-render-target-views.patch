Subject: d3d11: retain backend textures through owned render-target views

d3d11: retain backend textures through owned render-target views. The separate On12 host has no WineD3D resource to dispatch through;
route only backend-owned objects and preserve the ordinary WineD3D path.

diff --git a/dlls/d3d11/d3d11_main.c b/dlls/d3d11/d3d11_main.c
index b04ec74f..52b6bffe 100644
--- a/dlls/d3d11/d3d11_main.c
+++ b/dlls/d3d11/d3d11_main.c
@@ -511,6 +511,9 @@ struct d3d11_on12_backend
     UINT creation_flags;
     wine_d3d11on12_create_buffer_fn create_buffer;
     wine_d3d11on12_destroy_buffer_fn destroy_buffer;
+    HRESULT (WINAPI *create_rtv)(struct wine_d3d11on12_adapter_device *, void *,
+            const D3D11_RENDER_TARGET_VIEW_DESC *, void *);
+    HRESULT (WINAPI *destroy_rtv)(void *);
     wine_d3d11on12_create_texture2d_fn create_texture2d;
     wine_d3d11on12_destroy_texture2d_fn destroy_texture2d;
     wine_d3d11on12_set_vertex_buffers_fn set_vertex_buffers;
@@ -855,8 +858,34 @@ static HRESULT d3d11_on12_backend_get_d3d12_device(struct d3d_device *device,
  * the table where a shifted entry would be least visible, because every op
  * here is implemented and none is NULL, so nothing would crash -- each call
  * would simply reach the wrong function through the wrong signature. */
+static HRESULT d3d11_on12_backend_create_rtv(struct d3d_device *device,
+        ID3D11Resource *resource, const D3D11_RENDER_TARGET_VIEW_DESC *desc,
+        struct d3d_rendertarget_view *view)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    struct d3d_texture2d *texture;
+    D3D11_RESOURCE_DIMENSION dimension;
+    if (!resource) return E_INVALIDARG;
+    ID3D11Resource_GetType(resource, &dimension);
+    if (dimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D) return DXGI_ERROR_UNSUPPORTED;
+    texture = unsafe_impl_from_ID3D11Texture2D((ID3D11Texture2D *)resource);
+    if (!texture || !texture->backend_texture.runtime_state) return E_INVALIDARG;
+    view->backend_view.size = sizeof(view->backend_view);
+    return backend->create_rtv(&backend->adapter, &texture->backend_texture, desc, &view->backend_view);
+}
+
+static void d3d11_on12_backend_destroy_rtv(struct d3d_device *device, struct d3d_rendertarget_view *view)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    HRESULT hr = backend->destroy_rtv(&view->backend_view);
+    if (FAILED(hr)) WARN("On12 RTV destruction failed, hr %#lx.\n", hr);
+}
+
 static const struct d3d11_backend_ops d3d11_on12_backend_ops =
 {
+    .create_rtv = d3d11_on12_backend_create_rtv,
+    .destroy_rtv = d3d11_on12_backend_destroy_rtv,
+
     .destroy_device = d3d11_on12_backend_destroy,
     .get_feature_level = d3d11_on12_backend_get_feature_level,
     .get_creation_flags = d3d11_on12_backend_get_creation_flags,
@@ -1008,6 +1037,17 @@ static HRESULT d3d11_on12_create_unpublished_backend(IUnknown *device,
         return DXGI_ERROR_UNSUPPORTED;
     }
 
+    address = GetProcAddress(backend->core_module, "WineD3D11On12CreateRenderTargetViewV1");
+    memcpy(&backend->create_rtv, &address, sizeof(backend->create_rtv));
+    address = GetProcAddress(backend->core_module, "WineD3D11On12DestroyRenderTargetViewV1");
+    memcpy(&backend->destroy_rtv, &address, sizeof(backend->destroy_rtv));
+    if (!backend->create_rtv || !backend->destroy_rtv)
+    {
+        FreeLibrary(backend->core_module);
+        free(backend);
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+
     address = GetProcAddress(backend->core_module,
             "WineD3D11On12OpenAdapterV1");
     memcpy(&open_adapter, &address, sizeof(open_adapter));
diff --git a/dlls/d3d11/d3d11_private.h b/dlls/d3d11/d3d11_private.h
