+/* An owned buffer of this device, or NULL. */
+static struct d3d_buffer *d3d11_on12_buffer(struct d3d_device *device, ID3D11Resource *resource)
+{
+    D3D11_RESOURCE_DIMENSION type;
+    struct d3d_buffer *buffer;
+    if (!resource) return NULL;
+    ID3D11Resource_GetType(resource, &type);
+    if (type != D3D11_RESOURCE_DIMENSION_BUFFER) return NULL;
+    buffer = unsafe_impl_from_ID3D11Buffer((ID3D11Buffer *)resource);
+    return buffer && buffer->device == &device->ID3D11Device5_iface
+            && buffer->backend_buffer.runtime_state ? buffer : NULL;
+}
