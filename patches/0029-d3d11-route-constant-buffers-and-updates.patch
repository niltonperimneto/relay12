+static void d3d11_on12_backend_update_subresource(struct d3d11_device_context *context,
+        ID3D11Resource *resource, UINT subresource, const D3D11_BOX *box, const void *data,
+        UINT row_pitch, UINT depth_pitch)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_buffer *buffer = d3d11_on12_buffer(context->device, resource);
+    struct d3d_texture2d *texture = d3d11_on12_texture(resource);
+    HRESULT hr;
+
+    if (buffer && !subresource)
+        hr = D3D11_ON12_CALL(backend, backend->update_buffer(&backend->adapter,
+                (struct wine_d3d11on12_buffer *)&buffer->backend_buffer, box, data, row_pitch, depth_pitch));
+    else if (texture && texture->device == &context->device->ID3D11Device5_iface)
+        hr = D3D11_ON12_CALL(backend, backend->update_texture(&backend->adapter,
+                &texture->backend_texture, subresource, box, data, row_pitch, depth_pitch));
+    else
+    {
+        WARN("On12 UpdateSubresource requires an owned buffer or Texture2D.\n");
+        return;
+    }
+    if (FAILED(hr)) WARN("On12 UpdateSubresource failed, hr %#lx.\n", hr);
+}
