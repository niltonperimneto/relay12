+/* A backend that owns constant buffers binds whole buffers only: offsets into
+ * a buffer (the *SetConstantBuffers1 ranges) are not routed yet. */
+static BOOL d3d11_backend_set_constant_buffers(struct d3d11_device_context *context,
+        enum wined3d_shader_type type, UINT start_slot, UINT buffer_count,
+        ID3D11Buffer *const *buffers, const UINT *first_constant, const UINT *num_constants)
+{
+    if (!context->device->backend_ops->set_constant_buffers)
+        return FALSE;
+    if (first_constant || num_constants)
+    {
+        WARN("On12 constant-buffer ranges are not supported.\n");
+        return TRUE;
+    }
+    context->device->backend_ops->set_constant_buffers(context, type, start_slot, buffer_count, buffers);
+    return TRUE;
+}
+
+/* Getters read the backend's retained bindings.  A whole-buffer binding is
+ * reported as constant 0 for ByteWidth / 16 constants, as D3D11 reports it. */
+static BOOL d3d11_backend_get_constant_buffers(struct d3d11_device_context *context,
+        enum wined3d_shader_type type, UINT start_slot, UINT buffer_count,
+        ID3D11Buffer **buffers, UINT *first_constant, UINT *num_constants)
+{
+    UINT stage = type == WINED3D_SHADER_TYPE_PIXEL ? 1 : 0, i;
+
+    if (!context->device->backend_ops->set_constant_buffers)
+        return FALSE;
+    if (start_slot > D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT
+            || buffer_count > D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT - start_slot)
+        return TRUE;
+    for (i = 0; i < buffer_count; ++i)
+    {
+        struct d3d11_backend_child *child = context->bound_cbs[stage][start_slot + i];
+        struct d3d_buffer *buffer = child ? child->object : NULL;
+
+        if (buffers)
+        {
+            buffers[i] = buffer ? &buffer->ID3D11Buffer_iface : NULL;
+            if (buffers[i]) ID3D11Buffer_AddRef(buffers[i]);
+        }
+        if (first_constant) first_constant[i] = 0;
+        if (num_constants) num_constants[i] = buffer ? buffer->desc.ByteWidth / 16 : 0;
+    }
+    return TRUE;
+}
