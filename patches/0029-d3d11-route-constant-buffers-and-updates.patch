+/* Vertex and pixel stages; the core is told which by its own stage value. */
+static void d3d11_on12_backend_set_constant_buffers(struct d3d11_device_context *context,
+        enum wined3d_shader_type type, UINT start, UINT count, ID3D11Buffer *const *buffers)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct wine_d3d11on12_buffer *handles[D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT];
+    struct d3d_buffer *resolved[D3D11_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT];
+    UINT stage, i;
+    HRESULT hr;
+
+    if (type != WINED3D_SHADER_TYPE_VERTEX && type != WINED3D_SHADER_TYPE_PIXEL) return;
+    stage = type == WINED3D_SHADER_TYPE_PIXEL ? 1 : 0;
+    if (start > ARRAY_SIZE(handles) || count > ARRAY_SIZE(handles) - start || (count && !buffers)) return;
+    for (i = 0; i < count; ++i)
+    {
+        struct d3d_buffer *buffer = unsafe_impl_from_ID3D11Buffer(buffers[i]);
+        if (buffer && (buffer->device != &context->device->ID3D11Device5_iface || !buffer->backend_child.destroy))
+        { WARN("On12 constant-buffer binding requires buffers from this device.\n"); return; }
+        resolved[i] = buffer;
+        handles[i] = buffer ? (struct wine_d3d11on12_buffer *)&buffer->backend_buffer : NULL;
+    }
+    hr = D3D11_ON12_CALL(backend, backend->set_constant_buffers(&backend->adapter,
+            stage ? WINE_D3D11ON12_SHADER_PIXEL : WINE_D3D11ON12_SHADER_VERTEX, start, count, handles));
+    if (FAILED(hr)) { WARN("On12 constant-buffer binding failed, hr %#lx.\n", hr); return; }
+    for (i = 0; i < count; ++i)
+        d3d11_backend_child_bind(&context->bound_cbs[stage][start + i],
+                resolved[i] ? &resolved[i]->backend_child : NULL);
+}
