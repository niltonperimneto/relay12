 };

+/* INIT_ONCE publishes a terminal result even on failure: a void context
+ * method cannot report allocation failure, and subsequent calls must neither
+ * retry allocation nor dispatch through a partially initialized adapter. */
+static BOOL CALLBACK d3d11_on12_initialize_backend(INIT_ONCE *once, void *param, void **context)
+{
+    struct d3d11_on12_backend *backend = param;
+    IUnknown *queues[] = {backend->queue};
+    HRESULT hr;
+
+    (void)once;
+    (void)context;
+    backend->adapter.size = sizeof(backend->adapter);
+    hr = backend->open_adapter((IUnknown *)backend->device12, queues, 1,
+            backend->node_mask, &backend->adapter);
+    if (SUCCEEDED(hr))
+        hr = backend->check_frame_support(&backend->adapter);
+    if (FAILED(hr))
+    {
+        if (backend->adapter.runtime_state)
+            backend->core.close_adapter_device(&backend->adapter);
+        WARN("Deferred D3D11On12 adapter initialization failed, hr %#lx.\n", hr);
+    }
+    InterlockedExchange(&backend->initialization_hr, hr);
+    return TRUE;
+}
+
+static HRESULT d3d11_on12_initialization_result(struct d3d11_on12_backend *backend)
+{
+    return InterlockedCompareExchange(&backend->initialization_hr, 0, 0);
+}
+
+static HRESULT d3d11_on12_ensure_backend(struct d3d11_on12_backend *backend)
+{
+    HRESULT hr = d3d11_on12_initialization_result(backend);
+    if (FAILED(hr))
+        return hr;
+    if (!InitOnceExecuteOnce(&backend->initialization, d3d11_on12_initialize_backend,
+            backend, NULL))
+        InterlockedExchange(&backend->initialization_hr, E_FAIL);
+    return d3d11_on12_initialization_result(backend);
+}
+
+#define D3D11_ON12_CALL(backend, call) \
+    (SUCCEEDED(d3d11_on12_ensure_backend(backend)) ? (call) : \
+    d3d11_on12_initialization_result(backend))
+
 static void d3d11_on12_backend_destroy(struct d3d_device *device)
 {
     struct d3d11_on12_backend *backend = device->backend_private;
