+static HRESULT d3d11_on12_backend_create_buffer(struct d3d_device *device,
+        const D3D11_BUFFER_DESC *desc, const D3D11_SUBRESOURCE_DATA *data,
+        struct d3d_buffer *buffer)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    return backend->create_buffer(&backend->adapter, desc, data,
+            (struct wine_d3d11on12_buffer *)&buffer->backend_buffer);
+}
