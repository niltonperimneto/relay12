+static void d3d11_on12_backend_set_vertex_buffers(
+        struct d3d11_device_context *context, UINT start_slot,
+        UINT buffer_count, ID3D11Buffer *const *buffers,
+        const UINT *strides, const UINT *offsets)
+{
+    struct wine_d3d11on12_buffer *handles[D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT];
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    UINT i;
+    HRESULT hr;
+
+    if (buffer_count > ARRAY_SIZE(handles))
+        buffer_count = ARRAY_SIZE(handles);
+    for (i = 0; i < buffer_count; ++i)
+    {
+        struct d3d_buffer *buffer = unsafe_impl_from_ID3D11Buffer(buffers[i]);
+        handles[i] = buffer
+                ? (struct wine_d3d11on12_buffer *)&buffer->backend_buffer
+                : NULL;
+    }
+    hr = backend->set_vertex_buffers(&backend->adapter, start_slot,
+            buffer_count, handles, strides, offsets);
+    if (FAILED(hr))
+        WARN("D3D11On12 vertex-buffer binding failed, hr %#lx.\n", hr);
+}
