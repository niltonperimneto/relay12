+static void wined3d_backend_destroy_device(struct d3d_device *device)
+{
+    if (device->wined3d_device)
+        wined3d_device_decref(device->wined3d_device);
+}
+
+static D3D_FEATURE_LEVEL wined3d_backend_get_feature_level(struct d3d_device *device)
+{
+    return device->state->feature_level;
+}
+
+static UINT wined3d_backend_get_creation_flags(struct d3d_device *device)
+{
+    (void)device;
+    return 0;
+}
+
+static HRESULT wined3d_backend_get_device_removed_reason(struct d3d_device *device)
+{
+    (void)device;
+    return S_OK;
+}
+
+static void wined3d_backend_flush(struct d3d11_device_context *context)
+{
+    wined3d_device_context_flush(context->wined3d_context);
+}
+
+static const struct d3d11_backend_ops wined3d_backend_ops =
+{
+    wined3d_backend_destroy_device,
+    wined3d_backend_get_feature_level,
+    wined3d_backend_get_creation_flags,
+    wined3d_backend_get_device_removed_reason,
+    wined3d_backend_flush,
+};
