index 83f629b..ec9a0d8 100644
--- a/include/ImmediateContext.hpp
+++ b/include/ImmediateContext.hpp
@@ -1298,7 +1298,7 @@ public:
             {
                 return allocateFunc();
             }
-            catch( _com_error& hrEx )
+            catch( RelayHResultError& hrEx )
             {
                 if (hrEx.Error() != E_OUTOFMEMORY ||
                     !ResourceAllocationFallback(threadingContext))
