diff --git a/include/ThreadPool.hpp b/include/ThreadPool.hpp
index 7b0ef69..3a3f0a0 100644
--- a/include/ThreadPool.hpp
+++ b/include/ThreadPool.hpp
@@ -57,14 +57,14 @@ public:
         m_pPool = CreateThreadpool(nullptr);
         if (!m_pPool)
         {
-            throw _com_error(HRESULT_FROM_WIN32(GetLastError()));
+            throw RelayHResultError(HRESULT_FROM_WIN32(GetLastError()));
         }
 
         m_pCleanup = CreateThreadpoolCleanupGroup();
         if (!m_pCleanup)
         {
             CloseThreadpool(m_pPool);
-            throw _com_error(HRESULT_FROM_WIN32(GetLastError()));
+            throw RelayHResultError(HRESULT_FROM_WIN32(GetLastError()));
         }
 
         // No more failures
@@ -92,14 +92,14 @@ public:
     {
         if (Work.m_pWork != nullptr)
         {
-            throw _com_error(E_INVALIDARG);
+            throw RelayHResultError(E_INVALIDARG);
         }
 
         Work.m_WorkFunction = std::move(WorkFunction);
         Work.m_pWork = CreateThreadpoolWork(&CThreadPoolWork::WorkCallback, &Work, &m_Environment);
         if (!Work.m_pWork)
         {
-            throw _com_error(HRESULT_FROM_WIN32(GetLastError()));
+            throw RelayHResultError(HRESULT_FROM_WIN32(GetLastError()));
         }
 
         SubmitThreadpoolWork(Work.m_pWork);
