diff --git a/include/relay_atl_compat.hpp b/include/relay_atl_compat.hpp
new file mode 100644
index 0000000..9620c86
--- /dev/null
+++ b/include/relay_atl_compat.hpp
@@ -0,0 +1,17 @@
+// Copyright (c) relay12 contributors.
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <objbase.h>
+#include "relay_ownership.hpp"
+
+struct RelayCoTaskMemDeleter
+{
+    void operator()(void* pointer) const noexcept
+    {
+        CoTaskMemFree(pointer);
+    }
+};
+
+template <typename T>
+using RelayComHeapPtr = RelayHeapPtr<T, RelayCoTaskMemDeleter>;
