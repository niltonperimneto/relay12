+bool ImmediateContext::TrimResourcePools(relay12::PoolTrimReason reason)
+{
+    const bool pressure = m_BalancedMemory && reason == relay12::PoolTrimReason::Pressure;
+    const auto before = pressure ? m_UploadBufferPool.MemoryCounters().trims +
+        m_ReadbackBufferPool.MemoryCounters().trims + m_DecoderBufferPool.MemoryCounters().trims : 0;
+    m_UploadBufferPool.Trim(GetCompletedFenceValue(CommandListType(AllocatorHeapType::Upload)), reason);
+    m_ReadbackBufferPool.Trim(GetCompletedFenceValue(CommandListType(AllocatorHeapType::Readback)), reason);
+    m_DecoderBufferPool.Trim(GetCompletedFenceValue(CommandListType(AllocatorHeapType::Decoder)), reason);
+    // OOM retry must make progress; never spin on an unchanged bounded cache.
+    return !pressure || before != m_UploadBufferPool.MemoryCounters().trims +
+        m_ReadbackBufferPool.MemoryCounters().trims + m_DecoderBufferPool.MemoryCounters().trims;
+}
 
