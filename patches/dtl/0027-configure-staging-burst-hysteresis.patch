+// Device-local policy, with bounded decimal parsing. Missing settings keep
+// defaults; malformed values cannot silently disable memory reclamation.
+static UINT64 ReadPoolSetting(const char* name, UINT64 fallback, UINT64 maximum) noexcept
+{
+    char text[32] = {};
+    const DWORD length = GetEnvironmentVariableA(name, text, sizeof(text));
+    if (!length) return fallback;
+    std::uint64_t value = 0;
+    if (length < sizeof(text) && relay12::ParsePoolSetting(text, maximum, value)) return value;
+    std::fprintf(stderr, "d3d11on12 memory policy: invalid %s; using default %llu\n",
+        name, static_cast<unsigned long long>(fallback));
+    return fallback;
+}
 
