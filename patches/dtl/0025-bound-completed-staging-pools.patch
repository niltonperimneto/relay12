+namespace D3D12TranslationLayer {
+void ImmediateContext::ReportMemoryTelemetry() noexcept
+{
+    char enabled[2] = {};
+    if (GetEnvironmentVariableA("RELAY12_TELEMETRY", enabled, sizeof(enabled)) != 1 || enabled[0] != '1') return;
+    TrimResourcePools();
+    char report[768];
+    std::snprintf(report, sizeof(report),
+        "d3d11on12 memory telemetry: profile=%s reason=%s physical_bytes=%llu pool_counters_available=%u direct_attempts=%llu direct_success=%llu direct_fallbacks=%llu avoided_staging_bytes=%llu\n",
+        m_BalancedMemory ? "balanced" : "legacy", m_MemoryReason,
+        static_cast<unsigned long long>(m_PhysicalMemory), m_BalancedMemory ? 1u : 0u,
+        static_cast<unsigned long long>(m_DirectAttempts.load()), static_cast<unsigned long long>(m_DirectSuccess.load()),
+        static_cast<unsigned long long>(m_DirectFallbacks.load()), static_cast<unsigned long long>(m_DirectAvoidedBytes.load()));
+    OutputDebugStringA(report); std::fputs(report, stderr);
+    if (!m_BalancedMemory) return;
+    auto reportPool = [&](const char* name, TDynamicBufferPool& pool) {
+        const auto c = pool.MemoryCounters();
+        std::snprintf(report, sizeof(report),
+            "d3d11on12 pool telemetry: pool=%s retained_bytes=%llu peak_retained_bytes=%llu pending_bytes=%llu completed_bytes=%llu allocations=%llu reuses=%llu trims=%llu\n",
+            name, static_cast<unsigned long long>(c.retained), static_cast<unsigned long long>(c.peakRetained),
+            static_cast<unsigned long long>(c.pending), static_cast<unsigned long long>(c.completed),
+            static_cast<unsigned long long>(c.allocations), static_cast<unsigned long long>(c.reuses), static_cast<unsigned long long>(c.trims));
+        OutputDebugStringA(report); std::fputs(report, stderr);
+    };
+    reportPool("upload", m_UploadBufferPool);
+    reportPool("readback", m_ReadbackBufferPool);
+    reportPool("decoder", m_DecoderBufferPool);
+}
+}
