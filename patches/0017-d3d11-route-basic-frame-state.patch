Subject: d3d11: route offscreen target binding viewport and clear

d3d11: route offscreen target binding viewport and clear. The separate On12 host has no WineD3D resource to dispatch through;
route only backend-owned objects and preserve the ordinary WineD3D path.

diff --git a/dlls/d3d11/d3d11_main.c b/dlls/d3d11/d3d11_main.c
index 52b6bffe..b061d7a7 100644
--- a/dlls/d3d11/d3d11_main.c
+++ b/dlls/d3d11/d3d11_main.c
@@ -514,6 +514,9 @@ struct d3d11_on12_backend
     HRESULT (WINAPI *create_rtv)(struct wine_d3d11on12_adapter_device *, void *,
             const D3D11_RENDER_TARGET_VIEW_DESC *, void *);
     HRESULT (WINAPI *destroy_rtv)(void *);
+    HRESULT (WINAPI *set_render_target)(struct wine_d3d11on12_adapter_device *, void *);
+    HRESULT (WINAPI *set_viewport)(struct wine_d3d11on12_adapter_device *, const D3D11_VIEWPORT *);
+    HRESULT (WINAPI *clear_render_target)(struct wine_d3d11on12_adapter_device *, void *, const float *);
     wine_d3d11on12_create_texture2d_fn create_texture2d;
     wine_d3d11on12_destroy_texture2d_fn destroy_texture2d;
     wine_d3d11on12_set_vertex_buffers_fn set_vertex_buffers;
@@ -881,8 +884,52 @@ static void d3d11_on12_backend_destroy_rtv(struct d3d_device *device, struct d3d
     if (FAILED(hr)) WARN("On12 RTV destruction failed, hr %#lx.\n", hr);
 }
 
+static void d3d11_on12_backend_set_render_targets(struct d3d11_device_context *context,
+        UINT count, ID3D11RenderTargetView *const *views, ID3D11DepthStencilView *depth)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_rendertarget_view *view;
+    HRESULT hr;
+    if (count > 1 || depth || (count && !views))
+    {
+        WARN("On12 supports one render target and no depth view.\n");
+        return;
+    }
+    view = count ? unsafe_impl_from_ID3D11RenderTargetView(views[0]) : NULL;
+    hr = backend->set_render_target(&backend->adapter, view ? &view->backend_view : NULL);
+    if (FAILED(hr)) WARN("On12 target binding failed, hr %#lx.\n", hr);
+}
+
+static void d3d11_on12_backend_set_viewports(struct d3d11_device_context *context,
+        UINT count, const D3D11_VIEWPORT *viewports)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    HRESULT hr;
+    if (count > 1 || (count && !viewports))
+    {
+        WARN("On12 supports one viewport.\n");
+        return;
+    }
+    hr = backend->set_viewport(&backend->adapter, count ? viewports : NULL);
+    if (FAILED(hr)) WARN("On12 viewport failed, hr %#lx.\n", hr);
+}
+
+static void d3d11_on12_backend_clear_render_target(struct d3d11_device_context *context,
+        ID3D11RenderTargetView *iface, const float *color)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_rendertarget_view *view = unsafe_impl_from_ID3D11RenderTargetView(iface);
+    HRESULT hr = backend->clear_render_target(&backend->adapter,
+            view ? &view->backend_view : NULL, color);
+    if (FAILED(hr)) WARN("On12 clear failed, hr %#lx.\n", hr);
+}
+
 static const struct d3d11_backend_ops d3d11_on12_backend_ops =
 {
+    .set_render_targets = d3d11_on12_backend_set_render_targets,
+    .set_viewports = d3d11_on12_backend_set_viewports,
+    .clear_render_target = d3d11_on12_backend_clear_render_target,
+
     .create_rtv = d3d11_on12_backend_create_rtv,
     .destroy_rtv = d3d11_on12_backend_destroy_rtv,
 
@@ -1048,6 +1095,19 @@ static HRESULT d3d11_on12_create_unpublished_backend(IUnknown *device,
         return DXGI_ERROR_UNSUPPORTED;
     }
 
+    address = GetProcAddress(backend->core_module, "WineD3D11On12SetRenderTargetV1");
+    memcpy(&backend->set_render_target, &address, sizeof(backend->set_render_target));
+    address = GetProcAddress(backend->core_module, "WineD3D11On12SetViewportV1");
+    memcpy(&backend->set_viewport, &address, sizeof(backend->set_viewport));
+    address = GetProcAddress(backend->core_module, "WineD3D11On12ClearRenderTargetV1");
+    memcpy(&backend->clear_render_target, &address, sizeof(backend->clear_render_target));
+    if (!backend->set_render_target || !backend->set_viewport || !backend->clear_render_target)
+    {
+        FreeLibrary(backend->core_module);
+        free(backend);
+        return DXGI_ERROR_UNSUPPORTED;
+    }
+
     address = GetProcAddress(backend->core_module,
             "WineD3D11On12OpenAdapterV1");
     memcpy(&open_adapter, &address, sizeof(open_adapter));
diff --git a/dlls/d3d11/d3d11_private.h b/dlls/d3d11/d3d11_private.h
