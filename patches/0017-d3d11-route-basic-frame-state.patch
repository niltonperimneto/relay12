     if (rtv_count > ARRAY_SIZE(wined3d_rtvs))
     {
         WARN("View count %u exceeds limit.\n", rtv_count);
@@ -1440,6 +1446,12 @@ static void STDMETHODCALLTYPE d3d11_device_context_RSSetViewports(ID3D11DeviceCo
 
     TRACE("iface %p, viewport_count %u, viewports %p.\n", iface, viewport_count, viewports);
 
+    if (context->device->backend_ops->set_viewports)
+    {
+        context->device->backend_ops->set_viewports(context, viewport_count, viewports);
+        return;
+    }
+
     if (viewport_count > ARRAY_SIZE(wined3d_vp))
         return;
 
@@ -1555,6 +1567,12 @@ static void STDMETHODCALLTYPE d3d11_device_context_ClearRenderTargetView(ID3D11D
     TRACE("iface %p, render_target_view %p, color_rgba %s.\n",
             iface, render_target_view, debug_float4(color_rgba));
 
+    if (context->device->backend_ops->clear_render_target)
+    {
+        context->device->backend_ops->clear_render_target(context, render_target_view, color_rgba);
+        return;
+    }
+
     if (!view)
         return;
 
