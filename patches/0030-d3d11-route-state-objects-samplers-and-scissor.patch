+static HRESULT d3d11_on12_backend_create_state(struct d3d_device *device,
+        enum d3d11_backend_state_kind kind, const void *desc, void *handle)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    struct wine_d3d11on12_pipeline_state *state = handle;
+
+    state->size = sizeof(*state);
+    switch (kind)
+    {
+    case D3D11_BACKEND_STATE_BLEND:
+        return D3D11_ON12_CALL(backend, backend->create_blend_state(&backend->adapter, desc, state));
+    case D3D11_BACKEND_STATE_DEPTH_STENCIL:
+        return D3D11_ON12_CALL(backend, backend->create_depth_stencil_state(&backend->adapter, desc, state));
+    case D3D11_BACKEND_STATE_RASTERIZER:
+        return D3D11_ON12_CALL(backend, backend->create_rasterizer_state(&backend->adapter, desc, state));
+    case D3D11_BACKEND_STATE_SAMPLER:
+        return D3D11_ON12_CALL(backend, backend->create_sampler_state(&backend->adapter, desc, state));
+    }
+    return E_INVALIDARG;
+}
+
+static void d3d11_on12_backend_destroy_state(struct d3d_device *device, void *handle)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    HRESULT hr = D3D11_ON12_CALL(backend, backend->destroy_pipeline_state(handle));
+    if (FAILED(hr)) WARN("On12 state destruction failed, hr %#lx.\n", hr);
+}
+
+/* A state object usable on this device, as its core handle, or NULL with
+ * *valid cleared.  A null interface is valid and binds the default. */
+#define D3D11_ON12_STATE_HANDLE(context, impl, valid) \
+    ((impl) && ((impl)->device != &(context)->device->ID3D11Device5_iface \
+            || !(impl)->backend_child.destroy) ? (*(valid) = FALSE, NULL) \
+            : (impl) ? (struct wine_d3d11on12_pipeline_state *)&(impl)->backend_state : NULL)
+
+static void d3d11_on12_backend_set_blend_state(struct d3d11_device_context *context,
+        ID3D11BlendState *iface, const float *factor, UINT mask)
+{
+    static const float defaults[4] = {1.0f, 1.0f, 1.0f, 1.0f};
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_blend_state *state = unsafe_impl_from_ID3D11BlendState(iface);
+    BOOL valid = TRUE;
+    struct wine_d3d11on12_pipeline_state *handle = D3D11_ON12_STATE_HANDLE(context, state, &valid);
+    HRESULT hr;
+
+    if (!valid) { WARN("On12 blend state is not from this device.\n"); return; }
+    if (!factor) factor = defaults;
+    hr = D3D11_ON12_CALL(backend, backend->set_blend_state(&backend->adapter, handle, factor, mask));
+    if (FAILED(hr)) { WARN("On12 blend state binding failed, hr %#lx.\n", hr); return; }
+    d3d11_backend_child_bind(&context->bound_blend, state ? &state->backend_child : NULL);
+    memcpy(context->bound_blend_factor, factor, sizeof(context->bound_blend_factor));
+    context->bound_sample_mask = mask;
+}
+
+static void d3d11_on12_backend_set_depth_stencil_state(struct d3d11_device_context *context,
+        ID3D11DepthStencilState *iface, UINT reference)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_depthstencil_state *state = unsafe_impl_from_ID3D11DepthStencilState(iface);
+    BOOL valid = TRUE;
+    struct wine_d3d11on12_pipeline_state *handle = D3D11_ON12_STATE_HANDLE(context, state, &valid);
+    HRESULT hr;
+
+    if (!valid) { WARN("On12 depth/stencil state is not from this device.\n"); return; }
+    hr = D3D11_ON12_CALL(backend, backend->set_depth_stencil_state(&backend->adapter, handle, reference));
+    if (FAILED(hr)) { WARN("On12 depth/stencil binding failed, hr %#lx.\n", hr); return; }
+    d3d11_backend_child_bind(&context->bound_depth_stencil, state ? &state->backend_child : NULL);
+    context->bound_stencil_ref = reference;
+}
+
+static void d3d11_on12_backend_set_rasterizer_state(struct d3d11_device_context *context,
+        ID3D11RasterizerState *iface)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct d3d_rasterizer_state *state = unsafe_impl_from_ID3D11RasterizerState(iface);
+    BOOL valid = TRUE;
+    struct wine_d3d11on12_pipeline_state *handle = D3D11_ON12_STATE_HANDLE(context, state, &valid);
+    HRESULT hr;
+
+    if (!valid) { WARN("On12 rasterizer state is not from this device.\n"); return; }
+    hr = D3D11_ON12_CALL(backend, backend->set_rasterizer_state(&backend->adapter, handle));
+    if (FAILED(hr)) { WARN("On12 rasterizer binding failed, hr %#lx.\n", hr); return; }
+    d3d11_backend_child_bind(&context->bound_rasterizer, state ? &state->backend_child : NULL);
+}
+
+static void d3d11_on12_backend_set_samplers(struct d3d11_device_context *context,
+        enum wined3d_shader_type type, UINT start, UINT count, ID3D11SamplerState *const *samplers)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    struct wine_d3d11on12_pipeline_state *handles[D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT];
+    struct d3d_sampler_state *resolved[D3D11_COMMONSHADER_SAMPLER_SLOT_COUNT];
+    UINT stage, i;
+    HRESULT hr;
+
+    if (type != WINED3D_SHADER_TYPE_VERTEX && type != WINED3D_SHADER_TYPE_PIXEL) return;
+    stage = type == WINED3D_SHADER_TYPE_PIXEL ? 1 : 0;
+    if (start > ARRAY_SIZE(handles) || count > ARRAY_SIZE(handles) - start || (count && !samplers)) return;
+    for (i = 0; i < count; ++i)
+    {
+        BOOL valid = TRUE;
+        resolved[i] = unsafe_impl_from_ID3D11SamplerState(samplers[i]);
+        handles[i] = D3D11_ON12_STATE_HANDLE(context, resolved[i], &valid);
+        if (!valid) { WARN("On12 sampler binding requires samplers from this device.\n"); return; }
+    }
+    hr = D3D11_ON12_CALL(backend, backend->set_samplers(&backend->adapter,
+            stage ? WINE_D3D11ON12_SHADER_PIXEL : WINE_D3D11ON12_SHADER_VERTEX, start, count, handles));
+    if (FAILED(hr)) { WARN("On12 sampler binding failed, hr %#lx.\n", hr); return; }
+    for (i = 0; i < count; ++i)
+        d3d11_backend_child_bind(&context->bound_samplers[stage][start + i],
+                resolved[i] ? &resolved[i]->backend_child : NULL);
+}
+
+static void d3d11_on12_backend_set_scissor_rects(struct d3d11_device_context *context,
+        UINT count, const D3D11_RECT *rects)
+{
+    struct d3d11_on12_backend *backend = context->device->backend_private;
+    HRESULT hr;
+
+    if (count > ARRAY_SIZE(context->bound_scissor_rects) || (count && !rects)) return;
+    hr = D3D11_ON12_CALL(backend, backend->set_scissor_rects(&backend->adapter, count, rects));
+    if (FAILED(hr)) { WARN("On12 scissor rectangles failed, hr %#lx.\n", hr); return; }
+    if (count) memcpy(context->bound_scissor_rects, rects, count * sizeof(*rects));
+    context->bound_scissor_count = count;
+}
