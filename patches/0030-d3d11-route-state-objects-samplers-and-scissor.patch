+/* Create a state's backend object.  Called under the wined3d mutex, after the
+ * state is in its device's tree and before it is published. */
+static HRESULT d3d_state_create_backend(struct d3d_device *device, enum d3d11_backend_state_kind kind,
+        const void *desc, struct d3d11_backend_child *child, void *backend_state, void *object)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = device->backend_ops->create_state(device, kind, desc, backend_state)))
+        return hr;
+    child->refs = 1;
+    child->object = object;
+    return S_OK;
+}
