+    D3D11_ON12_RESOLVE(set_blend_state, "WineD3D11On12SetBlendStateV1");
+    D3D11_ON12_RESOLVE(set_depth_stencil_state, "WineD3D11On12SetDepthStencilStateV1");
+    D3D11_ON12_RESOLVE(set_rasterizer_state, "WineD3D11On12SetRasterizerStateV1");
+    D3D11_ON12_RESOLVE(set_samplers, "WineD3D11On12SetSamplersV1");
+    D3D11_ON12_RESOLVE(set_scissor_rects, "WineD3D11On12SetScissorRectsV1");
+#undef D3D11_ON12_RESOLVE
+    if (!backend->create_blend_state || !backend->create_depth_stencil_state
+            || !backend->create_rasterizer_state || !backend->create_sampler_state
+            || !backend->destroy_pipeline_state || !backend->set_blend_state
+            || !backend->set_depth_stencil_state || !backend->set_rasterizer_state
+            || !backend->set_samplers || !backend->set_scissor_rects)
