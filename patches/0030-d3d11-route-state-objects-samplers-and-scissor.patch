+/* The last public reference and the last binding are both gone.  A Create*
+ * with an identical description may have found the state in the tree and
+ * re-referenced it since; then it lives on. */
+static void d3d_blend_state_backend_destroy(void *object)
+{
+    struct d3d_blend_state *state = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(state->device);
+
+    wined3d_mutex_lock();
+    if (InterlockedCompareExchange(&state->backend_child.refs, 0, 0))
+    {
+        wined3d_mutex_unlock();
+        return;
+    }
+    wine_rb_remove(&device->blend_states, &state->entry);
+    wined3d_mutex_unlock();
+    device->backend_ops->destroy_state(device, &state->backend_state);
+    wined3d_private_store_cleanup(&state->private_store);
+    free(state);
+}
