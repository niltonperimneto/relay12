+            relay12::UmaInitialTextureEligible(createArgs.m_desc12))
+        {
+            const auto& data = pCreateResource->pInitialDataUP[0];
+            unique_comptr<ID3D12Resource> candidate;
+            const HRESULT directHr = relay12::CreateUmaInitialTexture(context.m_pDevice12.get(), context.GetNodeMask(),
+                createArgs.m_desc12, data.pSysMem, data.SysMemPitch, data.SysMemSlicePitch, &candidate);
+            if (directHr == S_OK)
+            {
+                auto directArgs = createArgs;
+                directArgs.m_heapDesc.Properties = CD3DX12_HEAP_PROPERTIES(D3D12_CPU_PAGE_PROPERTY_WRITE_BACK, D3D12_MEMORY_POOL_L0,
+                    context.GetNodeMask(), context.GetNodeMask());
+                directArgs.m_heapDesc.Flags = D3D12_HEAP_FLAG_NONE;
+                // Synchronous construction takes its own reference. Clear this
+                // temporary callback before the candidate's local owner dies.
+                directArgs.m_PrivateCreateFn = [&](const D3D12TranslationLayer::ResourceCreationArgs&, ID3D12SwapChainAssistant*, ID3D12Resource** result) {
+                    *result = candidate.get();
+                    (*result)->AddRef();
+                };
+                spUnderlyingResource = D3D12TranslationLayer::Resource::CreateResource(
+                    &context, directArgs, pDevice->GetResourceAllocationContext());
+                spUnderlyingResource->Parent()->m_PrivateCreateFn = {};
+                directInitialUpload = true;
+                UINT64 stagingBytes = 0;
+                context.m_pDevice12->GetCopyableFootprints(&createArgs.m_desc12, 0, 1, 0, nullptr, nullptr, nullptr, &stagingBytes);
+                context.RecordDirectUpload(true, stagingBytes);
+            }
+            else
+            {
+                context.RecordDirectUpload(false);
+                ThrowFailure(directHr);
+            }
+        }
+        if (!spUnderlyingResource) spUnderlyingResource = CreateAndRetry();
 
