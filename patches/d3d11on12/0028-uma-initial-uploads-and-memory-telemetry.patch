+        unique_comptr<D3D12TranslationLayer::Resource> spUnderlyingResource;
+        bool directInitialUpload = false;
+        if (context.UseDirectInitialUpload() && pCreateResource->pInitialDataUP &&
+            (pCreateResource->Usage == D3D10_DDI_USAGE_DEFAULT || pCreateResource->Usage == D3D10_DDI_USAGE_IMMUTABLE) &&
