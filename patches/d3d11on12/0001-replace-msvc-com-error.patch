--- a/src/device.cpp
+++ b/src/device.cpp
@@ -1087,7 +1087,7 @@ namespace D3D11On12
         m_SharedResourceHelpers.QueryResourceInfoFromKMTHandle(hKMTHandle, pFlagOverrides, &resourceInfoNextLayer);
         switch (resourceInfoNextLayer.m_Type)
