From: relay12 contributors
Subject: [PATCH] d3d11on12: replace ATL COM pointer dependency

Use relay12's shared, contract-tested ownership helper instead of ATL.
---
diff --git a/include/adapter.hpp b/include/adapter.hpp
--- a/include/adapter.hpp
+++ b/include/adapter.hpp
@@ -27,7 +27,7 @@ namespace D3D11On12
 
     public:
-        CComPtr<ID3D12Device1> m_pUnderlyingDevice;
+        RelayComPtr<ID3D12Device1> m_pUnderlyingDevice;
         ID3D12CommandQueue* m_p3DCommandQueue;
-        CComPtr<ID3D12CompatibilityDevice> m_pCompatDevice;
+        RelayComPtr<ID3D12CompatibilityDevice> m_pCompatDevice;
 
         UINT m_NodeIndex;
diff --git a/include/pch.hpp b/include/pch.hpp
--- a/include/pch.hpp
+++ b/include/pch.hpp
@@ -8,5 +8,6 @@
 #include <d3dx11on12.h>
 
 #include "SharedResourceHelpers.hpp"
+#include "relay_ownership.hpp"
 
 #ifdef WIN32_LEAN_AND_MEAN
diff --git a/src/shader.cpp b/src/shader.cpp
--- a/src/shader.cpp
+++ b/src/shader.cpp
@@ -311,6 +311,6 @@ namespace D3D11On12
         }
         if (spDxil.m_pData == nullptr)
         {
-            CComPtr<IDxbcConverter> spConverter;
+            RelayComPtr<IDxbcConverter> spConverter;
             ThrowFailure(pfnDxcCreateInstance(CLSID_DxbcConverter, IID_PPV_ARGS(&spConverter)));
 
@@ -321,4 +321,4 @@ namespace D3D11On12
             {
                 auto pfnCreateValidator = reinterpret_cast<decltype(&DxcCreateInstance)>(GetProcAddress(hDXIL, "DxcCreateInstance"));
-                CComPtr<IDxcValidator> spValidator;
+                RelayComPtr<IDxcValidator> spValidator;
                 ThrowFailure(pfnCreateValidator(CLSID_DxcValidator, IID_PPV_ARGS(&spValidator)));
@@ -334,3 +334,3 @@ namespace D3D11On12
                 } Blob = { spDxil.m_pData, DxilSize };
-                CComPtr<IDxcOperationResult> spResult;
+                RelayComPtr<IDxcOperationResult> spResult;
                 ThrowFailure(spValidator->Validate(&Blob, 0, &spResult));
-- 
2.51.0
