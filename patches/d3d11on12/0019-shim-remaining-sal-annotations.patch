index eb8fe3c..b34e12e 100644
--- a/include/pch.hpp
+++ b/include/pch.hpp
@@ -41,6 +41,427 @@ WINADAPTER_IID(IDxbcConverter,
 #ifndef _Maybenull_
 #define _Maybenull_
 #endif
