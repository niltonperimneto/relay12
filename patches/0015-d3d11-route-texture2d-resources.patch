     wine_d3d11on12_set_vertex_buffers_fn set_vertex_buffers;
     wine_d3d11on12_set_index_buffer_fn set_index_buffer;
     wine_d3d11on12_create_input_layout_fn create_input_layout;
@@ -630,6 +649,30 @@
             (struct wine_d3d11on12_buffer *)&buffer->backend_buffer);
     if (FAILED(hr))
         WARN("D3D11On12 buffer destruction failed, hr %#lx.\n", hr);
+}
+
+static HRESULT d3d11_on12_backend_create_texture2d(struct d3d_device *device,
+        const D3D11_TEXTURE2D_DESC *desc, const D3D11_SUBRESOURCE_DATA *data,
+        struct d3d_texture2d *texture)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    return backend->create_texture2d(&backend->adapter, desc, data,
+            (struct wine_d3d11on12_texture2d *)&texture->backend_texture);
+}
+
+/* Destruction cannot report a failure to the application: ID3D11Texture2D
+ * has no failing release.  The warning is the whole remedy, which is why the
+ * core is responsible for staying consistent when it refuses -- a refused
+ * destroy leaves the driver object owned by the core's registry and freed at
+ * device teardown, not leaked. */
+static void d3d11_on12_backend_destroy_texture2d(struct d3d_device *device,
+        struct d3d_texture2d *texture)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    HRESULT hr = backend->destroy_texture2d(
+            (struct wine_d3d11on12_texture2d *)&texture->backend_texture);
+    if (FAILED(hr))
+        WARN("D3D11On12 texture destruction failed, hr %#lx.\n", hr);
 }
 
