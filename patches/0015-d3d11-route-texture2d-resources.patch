+/* Designated rather than positional, and deliberately so.
+ *
+ * This table was positional, and two members were then added to
+ * struct d3d11_backend_ops without adding two entries here.  Every
+ * initialiser past destroy_buffer shifted by one pair: create_texture2d
+ * received wined3d_backend_set_vertex_buffers, destroy_vertex_shader
+ * received wined3d_backend_set_vertex_shader, set_vertex_shader and
+ * set_pixel_shader became NULL, and the last two members were left
+ * uninitialised.  Releasing a vertex shader on the ordinary WineD3D path
+ * would have called a binding function through a destroy signature.
+ *
+ * Naming each member makes a future insertion inert here instead of
+ * silently rebinding every slot after it.  Members WineD3D does not
+ * implement stay absent: C zero-initialises them, and a NULL op is how a
+ * backend says "use the WineD3D path", which the call sites already test
+ * for. */
 static const struct d3d11_backend_ops wined3d_backend_ops =
 {
-    wined3d_backend_destroy_device,
-    wined3d_backend_get_feature_level,
-    wined3d_backend_get_creation_flags,
-    wined3d_backend_get_device_removed_reason,
-    wined3d_backend_flush,
-    wined3d_backend_draw,
-    wined3d_backend_draw_indexed,
-    wined3d_backend_draw_instanced,
-    wined3d_backend_draw_indexed_instanced,
-    wined3d_backend_set_primitive_topology,
-    NULL,
-    NULL,
-    wined3d_backend_set_vertex_buffers,
-    wined3d_backend_set_index_buffer,
-    NULL,
-    NULL,
-    NULL,
-    NULL,
-    NULL,
-    NULL,
-    NULL,
-    wined3d_backend_set_vertex_shader,
-    wined3d_backend_set_pixel_shader,
-    NULL,
-    NULL,
-    NULL,
-    NULL,
+    .destroy_device = wined3d_backend_destroy_device,
+    .get_feature_level = wined3d_backend_get_feature_level,
+    .get_creation_flags = wined3d_backend_get_creation_flags,
+    .get_device_removed_reason = wined3d_backend_get_device_removed_reason,
+    .flush = wined3d_backend_flush,
+    .draw = wined3d_backend_draw,
+    .draw_indexed = wined3d_backend_draw_indexed,
+    .draw_instanced = wined3d_backend_draw_instanced,
+    .draw_indexed_instanced = wined3d_backend_draw_indexed_instanced,
+    .set_primitive_topology = wined3d_backend_set_primitive_topology,
+    .set_vertex_buffers = wined3d_backend_set_vertex_buffers,
+    .set_index_buffer = wined3d_backend_set_index_buffer,
+    .set_vertex_shader = wined3d_backend_set_vertex_shader,
+    .set_pixel_shader = wined3d_backend_set_pixel_shader,
 };
 
