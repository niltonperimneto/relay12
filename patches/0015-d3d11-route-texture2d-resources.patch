 struct wine_d3d11on12_buffer
+{
+    UINT size;
+    UINT reserved;
+    void *driver_resource;
+    void *runtime_state;
+};
+
+/* Laid out identically to the buffer handle because the core keeps both in
+ * one resource registry, but kept a distinct type so that a texture handle
+ * cannot be passed to a buffer entry point.  The core checks the kind again
