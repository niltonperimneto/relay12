 typedef HRESULT (WINAPI *wine_d3d11on12_destroy_buffer_fn)(
         struct wine_d3d11on12_buffer *);
+typedef HRESULT (WINAPI *wine_d3d11on12_create_texture2d_fn)(
+        struct wine_d3d11on12_adapter_device *, const D3D11_TEXTURE2D_DESC *,
+        const D3D11_SUBRESOURCE_DATA *, struct wine_d3d11on12_texture2d *);
+typedef HRESULT (WINAPI *wine_d3d11on12_destroy_texture2d_fn)(
+        struct wine_d3d11on12_texture2d *);
 typedef HRESULT (WINAPI *wine_d3d11on12_set_vertex_buffers_fn)(
         struct wine_d3d11on12_adapter_device *, UINT, UINT,
