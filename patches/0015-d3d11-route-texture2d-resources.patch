+/* Whether the D3D11On12 backend owns this texture's only resource.
+ *
+ * Set together in d3d_texture2d_create and never afterwards, so the size
+ * field answers the question the rest of this file keeps asking: a backend
+ * texture has no wined3d_texture, no dxgi_resource, and no swapchain, and
+ * every method that would reach one has to say so instead. */
+static inline BOOL d3d_texture2d_is_backend(const struct d3d_texture2d *texture)
+{
+    return texture->backend_texture.size != 0;
+}
+
 /* ID3D11Texture2D methods */
 
 static HRESULT STDMETHODCALLTYPE d3d11_texture2d_QueryInterface(ID3D11Texture2D *iface, REFIID riid, void **object)
@@ -532,6 +561,16 @@
         *object = &texture->ID3D10Texture2D_iface;
         IUnknown_AddRef((IUnknown *)*object);
         return S_OK;
+    }
+
+    /* A backend texture has no DXGI resource to forward to; see
+     * d3d_texture2d_create.  Reporting the interface as absent is the
+     * truthful answer and keeps this from dereferencing NULL. */
+    if (d3d_texture2d_is_backend(texture))
+    {
+        WARN("%s not implemented for backend textures.\n", debugstr_guid(riid));
+        *object = NULL;
+        return E_NOINTERFACE;
     }
 
     TRACE("Forwarding to dxgi resource.\n");
@@ -555,7 +594,10 @@
     if (refcount == 1)
     {
         ID3D11Device5_AddRef(texture->device);
-        wined3d_texture_incref(texture->wined3d_texture);
+        /* Paired with the guarded decref in Release: a backend texture has
+         * no wined3d object, and its lifetime is this refcount alone. */
+        if (texture->wined3d_texture)
+            wined3d_texture_incref(texture->wined3d_texture);
         if (texture->swapchain)
             wined3d_swapchain_incref(texture->swapchain);
     }
@@ -573,11 +615,23 @@
     if (!refcount)
     {
         ID3D11Device5 *device = texture->device;
+        struct d3d_device *device_impl = impl_from_ID3D11Device5(device);
+
+        /* Tested on the texture, not on the device.  Whether this object
+         * owns a driver resource is a property of how it was created, and
+         * a device that merely has the op may still hold textures it did
+         * not create -- a swapchain's, for one. */
+        if (d3d_texture2d_is_backend(texture))
+            device_impl->backend_ops->destroy_texture2d(device_impl, texture);
         if (texture->swapchain)
             wined3d_swapchain_decref(texture->swapchain);
         /* Releasing the texture may free the d3d11 object, so do not access it
-         * after releasing the texture. */
-        wined3d_texture_decref(texture->wined3d_texture);
+         * after releasing the texture. A backend texture has no wined3d
+         * object to release; the backend owns the only resource. */
+        if (texture->wined3d_texture)
+            wined3d_texture_decref(texture->wined3d_texture);
+        else
+            free(texture);
         /* Release the device last, it may cause the wined3d device to be
          * destroyed. */
         ID3D11Device5_Release(device);
@@ -678,6 +732,14 @@
