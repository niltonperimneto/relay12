+    /* Routed before the WineD3D path and outside the mutex, because a
+     * backend texture has no WineD3D object at all: the driver resource is
+     * the only one, and there is no wined3d_texture for the lock to protect.
+     *
+     * A caller-supplied wined3d_texture is the swapchain case and stays on
+     * the WineD3D path unconditionally.  The swapchain owns that texture,
+     * and a backend device that adopted it would be claiming a resource it
+     * did not create, which is why this test comes first. */
+    if (!wined3d_texture && device->backend_ops->create_texture2d)
+    {
+        texture->backend_texture.size = sizeof(texture->backend_texture);
+        if (FAILED(hr = device->backend_ops->create_texture2d(device, desc,
+                data, texture)))
+        {
+            free(texture);
+            return hr;
+        }
+
+        /* MipLevels of zero asks the runtime for the full chain, and the
+         * application reads back what it got through GetDesc.  The WineD3D
+         * path resolves that below; the core resolves it the same way, so
+         * the count is recomputed here rather than left as the zero that
+         * was passed in. */
+        if (!texture->desc.MipLevels)
+            texture->desc.MipLevels
+                    = wined3d_log2i(max(desc->Width, desc->Height)) + 1;
+
+        /* No DXGI resource: d3d_device_create_dxgi_resource wraps a wined3d
+         * resource and this texture has none, so a backend texture does not
+         * answer IDXGISurface yet.  Left as a named gap rather than wrapped
