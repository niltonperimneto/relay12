@@ -0,0 +1,24 @@
+MODULE    = d3d11on12host.dll
+IMPORTS   = dxguid uuid dxgi wined3d
+PARENTSRC = ../d3d11
+EXTRADEFS = -DWINE_D3D11ON12_HOST
+EXTRAINCL = $(VKD3D_PE_CFLAGS)
+
+VER_FILEDESCRIPTION_STR = "Wine D3D11On12 Runtime Host"
+VER_PRODUCTVERSION      = 7,0,6002,18107
+
+SOURCES = \
+	async.c \
+	buffer.c \
+	d3d11_main.c \
+	decoder.c \
+	device.c \
+	inputlayout.c \
+	shader.c \
+	state.c \
+	texture.c \
+	utils.c \
+	view.c
+
+# This is intentionally a distinct module. The deployed public d3d11.dll is
+# relay12's PE router, while Apple's original module is named d3d11mt.dll.
