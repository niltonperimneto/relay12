+static void d3d11_on12_backend_wrapped_ownership(struct d3d_device *device,
+        ID3D11Resource *const *resources, UINT count, BOOL acquire)
+{
+    struct d3d11_on12_backend *backend = device->backend_private;
+    struct wine_d3d11on12_texture2d **handles = NULL;
+    struct d3d_texture2d *texture;
+    HRESULT hr;
+    UINT i;
+    if (resources && count)
+    {
+        if (!(handles = calloc(count, sizeof(*handles))))
+        { WARN("D3D11On12 ownership allocation failed.\n"); return; }
+        for (i = 0; i < count; ++i)
+        {
+            if (!(texture = d3d_texture2d_from_wrapped(resources[i], device)))
+            { WARN("D3D11On12 ownership rejected foreign resource.\n"); free(handles); return; }
+            handles[i] = (struct wine_d3d11on12_texture2d *)&texture->backend_texture;
+        }
+    }
+    /* Preserve empty-list versus NULL (release-all) semantics. */
+    if (resources && !count) return;
+    hr = backend->set_wrapped_ownership(&backend->adapter, handles, count, acquire);
+    if (FAILED(hr)) WARN("D3D11On12 wrapped ownership failed, hr %#lx.\n", hr);
+    free(handles);
 }
 
