+/* Allocate the COM shell before the core publishes its address-bound handle. */
+struct d3d_texture2d *d3d_texture2d_allocate_wrapped(void)
+{
+    struct d3d_texture2d *texture = calloc(1, sizeof(*texture));
+    if (!texture) return NULL;
+    texture->ID3D11Texture2D_iface.lpVtbl = &d3d11_texture2d_vtbl;
+    texture->ID3D10Texture2D_iface.lpVtbl = &d3d10_texture2d_vtbl;
+    texture->refcount = 1;
+    texture->backend_texture.size = sizeof(texture->backend_texture);
+    return texture;
+}
+
+struct d3d_texture2d *d3d_texture2d_from_wrapped(ID3D11Resource *resource, struct d3d_device *device)
+{
+    struct d3d_texture2d *texture;
+    if (!resource || (const void *)resource->lpVtbl != &d3d11_texture2d_vtbl) return NULL;
+    texture = CONTAINING_RECORD(resource, struct d3d_texture2d, ID3D11Texture2D_iface);
+    return texture->device == &device->ID3D11Device5_iface && texture->backend_texture.runtime_state
+            ? texture : NULL;
+}
