Subject: d3d11: retain backend children independently of public references

WineD3D normally keeps bound objects alive through private driver references.
The On12 frontend has no WineD3D objects, so releasing a bound COM child
previously freed the object still referenced by the driver. Give backend
children a private reference count, with one reference for each binding and
one for the public COM reference group. Private references do not retain the
device, preventing a device/context/child ownership cycle. Clear bindings
before core teardown; RTVs retain their texture through the same mechanism.
---
diff --git a/dlls/d3d11/buffer.c b/dlls/d3d11/buffer.c
index 7190c293..4091aa7c 100644
--- a/dlls/d3d11/buffer.c
+++ b/dlls/d3d11/buffer.c
@@ -70,6 +70,13 @@ static ULONG STDMETHODCALLTYPE d3d11_buffer_AddRef(ID3D11Buffer *iface)
 
     TRACE("%p increasing refcount to %lu.\n", buffer, refcount);
 
+    if (refcount == 1 && buffer->backend_child.destroy)
+    {
+        d3d11_backend_child_incref(&buffer->backend_child);
+        ID3D11Device5_AddRef(buffer->device);
+        return refcount;
+    }
+
     if (refcount == 1)
     {
         ID3D11Device5_AddRef(buffer->device);
@@ -86,6 +93,14 @@ static ULONG STDMETHODCALLTYPE d3d11_buffer_Release(ID3D11Buffer *iface)
 
     TRACE("%p decreasing refcount to %lu.\n", buffer, refcount);
 
+    if (!refcount && buffer->backend_child.destroy)
+    {
+        ID3D11Device5 *device = buffer->device;
+        d3d11_backend_child_decref(&buffer->backend_child);
+        ID3D11Device5_Release(device);
+        return 0;
+    }
+
     if (!refcount)
     {
         ID3D11Device5 *device = buffer->device;
