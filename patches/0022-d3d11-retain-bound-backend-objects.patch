 /* ID3D11Texture2D, ID3D10Texture2D */
+/* One private reference for each binding and one for the public reference
+ * group. Private references do not retain the device, avoiding a cycle from
+ * device -> context -> bound child -> device. */
+struct d3d11_backend_child
+{
+    LONG refs;
+    void *object;
+    void (*destroy)(void *);
+};
+
+static inline void d3d11_backend_child_incref(struct d3d11_backend_child *child)
+{
+    if (child) InterlockedIncrement(&child->refs);
+}
+
+static inline void d3d11_backend_child_decref(struct d3d11_backend_child *child)
+{
+    if (child && !InterlockedDecrement(&child->refs)) child->destroy(child->object);
+}
+
+static inline void d3d11_backend_child_bind(struct d3d11_backend_child **slot,
+        struct d3d11_backend_child *child)
+{
+    struct d3d11_backend_child *old = *slot;
+    d3d11_backend_child_incref(child);
+    *slot = child;
+    d3d11_backend_child_decref(old);
+}
