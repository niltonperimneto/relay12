+static void d3d11_on12_free_buffer(void *object)
+{
+    struct d3d_buffer *buffer = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(buffer->device);
+    device->backend_ops->destroy_buffer(device, buffer);
+    free(buffer);
+}
+
+static void d3d11_on12_free_texture2d(void *object)
+{
+    struct d3d_texture2d *texture = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(texture->device);
+    device->backend_ops->destroy_texture2d(device, texture);
+    free(texture);
+}
+
+static void d3d11_on12_free_input_layout(void *object)
+{
+    struct d3d_input_layout *layout = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(layout->device);
+    device->backend_ops->destroy_input_layout(device, layout);
+    wined3d_private_store_cleanup(&layout->private_store);
+    free(layout);
+}
+
+static void d3d11_on12_free_vertex_shader(void *object)
+{
+    struct d3d_vertex_shader *shader = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(shader->device);
+    device->backend_ops->destroy_vertex_shader(device, shader);
+    wined3d_private_store_cleanup(&shader->private_store);
+    free(shader);
+}
+
+static void d3d11_on12_free_pixel_shader(void *object)
+{
+    struct d3d_pixel_shader *shader = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(shader->device);
+    device->backend_ops->destroy_pixel_shader(device, shader);
+    wined3d_private_store_cleanup(&shader->private_store);
+    free(shader);
+}
+
+static void d3d11_on12_free_rendertarget_view(void *object)
+{
+    struct d3d_rendertarget_view *view = object;
+    struct d3d_device *device = impl_from_ID3D11Device5(view->device);
+    device->backend_ops->destroy_rtv(device, view);
+    wined3d_private_store_cleanup(&view->private_store);
+    d3d11_backend_child_decref(&unsafe_impl_from_ID3D11Texture2D((ID3D11Texture2D *)view->resource)->backend_child);
+    free(view);
+}
